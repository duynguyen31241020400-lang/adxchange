# Required at runtime (and on any host that prerenders DB-backed routes).
# `pnpm build` can succeed without a live DB (sitemap is force-dynamic).
# Prefer Neon pooled URL in .env.local (gitignored). Payload reads DATABASE_URI,
# and falls back to DATABASE_URL (Neon CLI / `neon env pull` convention).
DATABASE_URI=postgresql://adx:adx_dev_secret@127.0.0.1:5432/adx
DATABASE_URL=
# Required in production; local/build has a non-secret fallback in payload.config.ts
PAYLOAD_SECRET=change-me-to-a-long-random-string
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=cuong@adxchange.agency
NEXT_PUBLIC_SITE_URL=https://adxchange.agency
NEXT_PUBLIC_ALLOW_INDEX=false
NEXT_PUBLIC_GA_ID=
IP_HASH_SALT=change-me-ip-hash-salt
